  "file_suffix_grammar": {
    "subject": "idb目录中的最后basename，先UTF8验证。普通文件，排除directory及name-surrogate reparse组合。",
    "accepted_suffixes": [
      ".sqlite",
      ".sqlite-wal",
      ".sqlite-shm"
    ],
    "matching": "区分大小写。每个suffix都先检查basename长度>=suffix长度，再memcmp(basename+len-suffixlen,suffix,suffixlen)。是三个OR的接受条件，不是排除清单；不是仅比较扩展名枚举。",
    "examples": {
      "foo.sqlite": "accepted suffix",
      "foo.sqlite-wal": "accepted suffix",
      "foo.sqlite-shm": "accepted suffix",
      "foo.SQLITE": "not accepted by these suffix rules",
      "foo.sqlite.bak": "not accepted by these suffix rules",
      ".sqlite": "no extra nonempty stem restriction observed"
    },
    "native19": {
